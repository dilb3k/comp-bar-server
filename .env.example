# ===== WARNING: Rotate all secrets below before using in production! =====
# These values were placeholder examples. Generate fresh secrets.
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"
MONGODB_FALLBACK_URL="mongodb://127.0.0.1:27017/bar-backend"
PORT=4000
BOT_TOKEN="<your-telegram-bot-token>"
# Login OTP sender: copy BOT_TOKEN from the interactive hisvex-bot service.
# Set on BOTH API deployments (Railway primary and Render standby).
# Omit only if BOT_TOKEN above already belongs to that same interactive bot.
OTP_TELEGRAM_BOT_TOKEN="<hisvex-bot-BOT_TOKEN>"
TELEGRAM_CHAT_ID="<your-telegram-chat-id>"
# Ops/infra alerts (failover, DB errors, 5xx crashes) — separate chat from
# TELEGRAM_CHAT_ID's business-event reports. Falls back to TELEGRAM_CHAT_ID
# when unset.
ALERT_TELEGRAM_CHAT_ID="<your-ops-alert-chat-id>"
NODE_ENV=development
JWT_SECRET="<generate-a-strong-random-secret-at-least-32-chars>"
JWT_EXPIRES_IN="7d"
# JWT_REFRESH_SECRET — required when NODE_ENV=production (server refuses to boot without it).
# Optional in development/test, where it defaults to JWT_SECRET + "_refresh_salt_2024".
JWT_REFRESH_SECRET="<generate-a-different-strong-random-secret-at-least-32-chars>"
MIGRATION_ENABLED=false
# Enable public signup for ordinary tenant accounts (with a 7-day trial).
# Signup never creates a superAdmin. Unset/false disables signup with HTTP 403.
ALLOW_PUBLIC_REGISTER=true

# Comma-separated list of allowed browser origins for CORS (the web admin
# panel, plus any other domain that calls this API from a browser). Native
# apps (desktop/mobile) are unaffected — they don't send an Origin header.
# In development, unset/"*" allows any origin plus localhost. In production,
# unset/"*" falls back to https://hisvex-web.vercel.app with a warning —
# set this explicitly instead of relying on that fallback.
CLIENT_URL="https://hisvex-web.vercel.app"

# ===== hisvex-bot integration (subscription payments via Telegram) =====
# Shared secret the hisvex-bot service presents as X-Bot-Secret to call
# /api/bot/*. Must match the bot's own BOT_INTERNAL_SECRET exactly. Leave
# unset to keep the bot integration fully disabled (fails closed, not open).
BOT_INTERNAL_SECRET="<generate-a-long-random-secret, e.g. `openssl rand -hex 32`>"

# Click (click.uz) merchant credentials — optional, only needed once you've
# registered a Click Business account. See hisvex-bot/README.md § 5. Leave
# all three unset to keep Click payments disabled (manual card transfer
# still works without them).
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""

# ===== Cloudflare R2 (S3-compatible) product image storage =====
# All five optional in development/test — leave unset and product images
# fall back to the legacy base64-in-Mongo store (see
# modules/products/product-image.ts). REQUIRED in production: the server
# refuses to boot if NODE_ENV=production and any of these is missing, since
# production has no fallback path for image uploads.
# Cloudflare account id — the R2 endpoint is built as
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="<your-cloudflare-account-id>"
# R2 API token credentials (Cloudflare dashboard → R2 → Manage API Tokens).
R2_ACCESS_KEY_ID="<your-r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<your-r2-secret-access-key>"
# Bucket product images are uploaded to.
R2_BUCKET_NAME="hisvex-product-images"
# Public base URL images are served from — either R2's own public bucket
# URL (https://pub-<hash>.r2.dev) or a custom domain in front of the bucket.
# No trailing slash needed. Product imageUrl values are built as
# "${R2_PUBLIC_URL}/${key}".
R2_PUBLIC_URL="https://<your-public-r2-domain>"

# Capacity: per-host workers are capped by available CPU/RAM and Atlas budget.
WEB_CONCURRENCY=auto
# Include all simultaneously serving replicas (including rolling-deploy overlap).
DEPLOYMENT_REPLICAS=2
# Conservative sum of application + monitoring sockets across topology members.
# Set from your actual Atlas tier after reserving space for other applications.
MONGO_CONNECTION_BUDGET=660
MONGO_CONNECTION_RESERVE=24
MONGO_TOPOLOGY_MEMBERS=3
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
API_READ_LIMIT=3000
API_WRITE_LIMIT=600
# Only one deployment replica should schedule hourly jobs; each host uses slot 0.
RUN_SCHEDULED_JOBS=true
# Successful production access logs are sampled; all 4xx/5xx remain logged.
HTTP_LOG_SAMPLE_RATE=0.01
