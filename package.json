{
  "name": "bar-backend",
  "version": "1.1.1",
  "description": "Offline-first cashier backend with sync and multi-tenant support",
  "main": "backend/dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "build": "tsc -p backend/tsconfig.json",
    "start": "node --max-old-space-size=450 backend/dist/cluster.js",
    "check": "tsc --noEmit -p backend/tsconfig.json",
    "test": "tsc -p backend/tsconfig.json && NODE_ENV=test MONGODB_URL=mongodb://127.0.0.1:27017/bar-test JWT_SECRET=test_secret_min_16_chars node backend/dist/tests/business-rules.test.js",
    "test:integration": "npm run build && node scripts/test-integration.cjs",
    "start:single": "node --max-old-space-size=450 backend/dist/server.js",
    "test:capacity": "npm run build && node scripts/test-integration.cjs scripts/capacity.integration.test.cjs",
    "test:architecture": "npm run build && node --test scripts/architecture.test.cjs"
  },
  "keywords": [
    "express",
    "mongoose",
    "mongodb",
    "offline-first",
    "sync"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@types/morgan": "^1.9.10",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "@types/pdfkit": "^0.17.6"
  },
  "overrides": {
    "qs": "^6.16.0",
    "esbuild": "^0.28.1",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
