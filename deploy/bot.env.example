# /etc/hisvex/bot.env
#
#   sudo install -m 640 -o root -g hisvex bot.env.example /etc/hisvex/bot.env
#   sudo nano /etc/hisvex/bot.env

BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
ADMIN_APPROVAL_CHAT_ID=

# Point at the public domain, not http://127.0.0.1:4000. The bot and the API
# share a box today, but the moment they stop sharing one, a loopback URL
# fails silently at the worst time — and going through nginx also means the
# API sees a normal proxied request rather than a special-cased local one.
BACKEND_URL=https://api.example.com

# Must match api.env's BOT_INTERNAL_SECRET character for character.
BOT_INTERNAL_SECRET=

CARD_NUMBER=
CARD_HOLDER_NAME=

APP_DOWNLOAD_URL=https://hisvex-web.vercel.app
SUPPORT_TELEGRAM_USERNAME=dilbek7011
REMINDER_DAYS_BEFORE=3
