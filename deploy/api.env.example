# /etc/hisvex/api.env
#
#   sudo install -m 640 -o root -g hisvex api.env.example /etc/hisvex/api.env
#   sudo nano /etc/hisvex/api.env
#
# Two of these must be copied VERBATIM from the old Render service, not
# generated fresh:
#
#   MONGODB_URL  — a different cluster means every shop opens the app to an
#                  empty inventory.
#   JWT_SECRET   — tokens are signed with it; a new value signs out every
#                  phone, desktop and browser at once. JWT_REFRESH_SECRET too.
#
# Read them in the Render dashboard under the service's Environment tab.
#
# MONGODB_URL in particular must be copied character for character, including
# the part that looks like a typo. The production string ends in
# `.mongodb.net/?appName=...` with no database name in the path, so the driver
# falls back to Mongo's default database, `test` — and that is where all
# 1600+ inventory entries actually live. "Tidying" the URL by adding
# `/hisvex` or `/bar-backend` points the new server at an empty database that
# it will happily create and serve, and every shop opens the app to a blank
# inventory with no error anywhere.

NODE_ENV=production
PORT=4000

MONGODB_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# "*" is what the service ran with on Render. Narrow it to the real origins
# once the domain is settled — it is the only thing standing between the API
# and any website a logged-in user happens to visit.
CLIENT_URL=*

BUSINESS_DAY_START_HOUR=6
TIMEZONE_OFFSET=300

MIGRATION_ENABLED=false
ALLOW_PUBLIC_REGISTER=true

# Must match bot.env's value exactly, or /api/bot/* rejects the bot. Unset
# disables the integration entirely (fails closed).
BOT_INTERNAL_SECRET=

# Optional
BOT_TOKEN=
TELEGRAM_CHAT_ID=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# MOBILE_LATEST_VERSION / MOBILE_DOWNLOAD_URL are deliberately absent:
# /meta/app-version reads the GitHub release feed, and these would only
# shadow it with a value that goes stale.
